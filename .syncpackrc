{
  "versionGroups": [
    {
      "label": "Peer ranges are intentionally permissive",
      "packages": ["**"],
      "dependencies": ["**"],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "Internal packages should use workspace protocol",
      "packages": ["**"],
      "dependencies": ["@repo/**"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "workspace:*"
    }
  ]
}
