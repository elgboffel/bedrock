{
  "name": "bedrock",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preflight": "bash tooling/scripts/preflight.sh",
    "sst:bootstrap": "bash tooling/scripts/sst-bootstrap.sh",
    "deploy": "sst deploy",
    "dev": "pnpm preflight && bash -c 'set -a && source .env && set +a && exec turbo dev'",
    "start": "turbo start",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:deps": "syncpack lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "check": "biome check . && turbo typecheck check",
    "format": "biome format .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "*.{js,ts,tsx,astro,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@11.5.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "sst": "^4.15.2",
    "syncpack": "^15.3.1",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "24.16.0"
  }
}
