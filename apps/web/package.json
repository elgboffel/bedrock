{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsdown --watch\" \"nodemon dist/server-runner/index.mjs\"",
    "build": "astro build && tsdown",
    "start": "node dist/server-runner/index.mjs",
    "preview": "node dist/server-runner/index.mjs",
    "lint": "biome lint .",
    "typecheck": "astro check && tsc --noEmit",
    "format": "biome format ."
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^4.0.0",
    "@fastify/express": "^3.0.0",
    "@fastify/http-proxy": "^11.4.1",
    "@fastify/static": "^8.0.0",
    "@repo/common": "workspace:*",
    "@repo/ui": "workspace:*",
    "astro": "^5.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@biomejs/biome": "^2.3.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  }
}
