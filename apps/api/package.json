{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsdown --watch\" \"nodemon dist/index.mjs\"",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
