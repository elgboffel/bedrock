    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@effect/vitest": "^0.29.0",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "tsdown": "^0.20.3",
    "vitest": "^3.2.1"
  }
}
