{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SERVER_PORT=3001 concurrently \"tsdown --watch\" \"nodemon dist/index.mjs\"",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "format": "biome format .",
    "check": "layout-lint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@effect/platform-node": "^0.106.0",
    "@repo/common": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "drizzle-orm": "1.0.0-beta.22",
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@repo/layout-lint": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.19.19",
    "concurrently": "^10.0.0",
    "nodemon": "^3.1.14",
    "tsdown": "^0.22.1",
    "vitest": "^4.1.7"
  }
}
