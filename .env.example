# =============================================================================
# Bedrock - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Connection settings for @repo/database (Effect Config in packages/database/src/config.ts)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=

# --- Server ------------------------------------------------------------------
# Shared server config (Effect Config in packages/server/src/config.ts)
SERVER_PORT=
SERVER_HOST=
LOG_LEVEL=

# --- Internal Auth -----------------------------------------------------------
# Shared secret for web→api service-to-service authentication (required)
INTERNAL_AUTH_TOKEN=
# INTERNAL_AUTH_PREVIOUS_TOKEN=   # Optional: previous token for zero-downtime rotation
# INTERNAL_AUTH_HEADER=           # Optional: header name (default: x-internal-auth)

# --- API URL -----------------------------------------------------------------
# Used by the web app to proxy /api/* requests to the API server
API_URL=

# --- OpenTelemetry -----------------------------------------------------------
# Telemetry config (Effect Config in packages/telemetry/src/config.ts)
OTEL_SERVICE_NAME=
# OTEL_EXPORTER_ENDPOINT=
OTEL_SAMPLING_RATE=
OTEL_ENABLED=
